{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python \"${CURSOR_PLUGIN_ROOT}/hooks/session-start.py\"",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python \"${CURSOR_PLUGIN_ROOT}/hooks/remote-policy-check.py\"",
        "timeout": 6,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python \"${CURSOR_PLUGIN_ROOT}/hooks/policy-guard.py\"",
        "matcher": "(docker|podman|kubectl|nerdctl|containerd|firecracker|qemu|virsh|iptables|nft|ip )",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
